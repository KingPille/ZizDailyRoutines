<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <AssemblyName>OmenTools</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup />
  <ItemGroup />
  <ItemGroup>
    <Reference Include="Dalamud" />
    <Reference Include="AngleSharp">
      <HintPath>..\..\lib\AngleSharp.dll</HintPath>
    </Reference>
    <Reference Include="Lumina" />
    <Reference Include="FFXIVClientStructs" />
    <Reference Include="Lumina.Excel" />
    <Reference Include="Dalamud.Bindings.ImGui" />
    <Reference Include="InteropGenerator.Runtime" />
    <Reference Include="GuerrillaNtp">
      <HintPath>..\..\lib\GuerrillaNtp.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json" />
    <Reference Include="Markdig">
      <HintPath>..\..\lib\Markdig.dll</HintPath>
    </Reference>
    <Reference Include="Jeffijoe.MessageFormat">
      <HintPath>..\..\lib\Jeffijoe.MessageFormat.dll</HintPath>
    </Reference>
    <Reference Include="TinyPinyin">
      <HintPath>..\..\lib\TinyPinyin.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>